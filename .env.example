# ---------------------------------------------------------------------------
# RequireIQ environment configuration
# Copy to .env.local. Every value below is OPTIONAL — the app runs fully
# offline on the deterministic local analysis engine with no keys at all.
# ---------------------------------------------------------------------------

# Analysis provider: "local" (default, deterministic, offline) | "anthropic"
REQUIREIQ_AI_PROVIDER=local

# Only read server-side. Never exposed to the browser. Required only when
# REQUIREIQ_AI_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Model used when the anthropic provider is enabled.
ANTHROPIC_MODEL=claude-sonnet-5

# SQLite database file location (relative paths resolve from the repo root).
#
# Leave unset on a serverless host (Vercel, Lambda): the app then uses
# /tmp/requireiq.db, because the deployment bundle is read-only. That storage is
# ephemeral and per-instance - every instance re-seeds itself from the bundled
# corpus, so reads are correct, but a review decision only survives on the
# instance that recorded it. Durable multi-user writes need a hosted database.
REQUIREIQ_DB_PATH=data/requireiq.db

# Max accepted upload size in bytes for document ingestion (default 5 MiB).
REQUIREIQ_MAX_UPLOAD_BYTES=5242880
